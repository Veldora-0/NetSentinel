# ==============================================================================
# NetSentinel Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure local settings:
#   cp .env.example .env
#   chmod 600 .env
#
# IMPORTANT:
# - Never commit actual secrets or credentials to source control.
# - Explicit system environment variables always take precedence over .env.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Administrator Initial Bootstrap & Single-Admin Policy
# ------------------------------------------------------------------------------
# NetSentinel enforces a single administrator policy.
# The initial administrator account is created ONLY on first run when no
# administrator account exists in the database.
# Password must be at least 8 characters long.
#
# Safe Administrator Operations:
# - Initial bootstrap: Provide username and password below, or run:
#     python backend/bootstrap.py
# - Password recovery: If the admin password is lost, reset it safely using:
#     python backend/bootstrap.py --reset-password --username admin
# - Multi-admin resolution: If legacy databases contain multiple admins, resolve via:
#     python backend/bootstrap.py --resolve-multiple-admins
#
# Changing these values after initial bootstrap will NOT overwrite existing accounts.
NETSENTINEL_ADMIN_USERNAME=admin
NETSENTINEL_ADMIN_PASSWORD=

# ------------------------------------------------------------------------------
# 2. Defensive Firewall & Mitigation Safety Defaults
# ------------------------------------------------------------------------------
# Defensive cybersecurity settings: kept DISABLED by default for ordinary testing.
# Do NOT enable auto-blocking without explicit authorization.
NETSENTINEL_FIREWALL_ENABLED=false
NETSENTINEL_AUTO_BLOCK=false
NETSENTINEL_FIREWALL_DRY_RUN=true
NETSENTINEL_FIREWALL_CHAIN=NETSENTINEL

# ------------------------------------------------------------------------------
# 3. Server Binding & Network Interface
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=5000
# Network interface for AF_PACKET raw frame capture (e.g., eth0, enp0s3, or leave blank for auto-discovery)
NETSENTINEL_INTERFACE=enp0s3

# ------------------------------------------------------------------------------
# 4. Security & Authentication Settings
# ------------------------------------------------------------------------------
SECRET_KEY=change-this-to-a-secure-random-string-in-production
NETSENTINEL_AUTH_ENABLED=true
NETSENTINEL_AUTH_TOKEN_EXPIRE_SECONDS=86400.0
NETSENTINEL_PASSWORD_MIN_LENGTH=8
NETSENTINEL_API_RATE_LIMIT=240
NETSENTINEL_SENSITIVE_RATE_LIMIT=10

# ------------------------------------------------------------------------------
# 5. External Threat Intelligence Providers (Optional)
# ------------------------------------------------------------------------------
NETSENTINEL_TI_ENABLED=false
NETSENTINEL_ABUSEIPDB_ENABLED=false
NETSENTINEL_ABUSEIPDB_API_KEY=
NETSENTINEL_VT_ENABLED=false
NETSENTINEL_VT_API_KEY=
